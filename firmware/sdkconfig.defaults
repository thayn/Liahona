# ---- Target / board ----
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_FREERTOS_HZ=1000

# ---- Waveshare 4" round 720x720 screen (NOT the 3.4" 800x800 default) ----
CONFIG_BSP_LCD_TYPE_720_720_4_INCH=y
CONFIG_BSP_LCD_COLOR_FORMAT_RGB565=y

# ---- LVGL ----
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_ASSERT_HANDLER_INCLUDE="assert.h"
CONFIG_LV_USE_OBSERVER=y

# ---- SD card: long file names ----
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# ---- Logging ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- Wi-Fi updates (v0.5) ----
# Wi-Fi comes from the ESP32-C6 on the board (ESP-Hosted over SDIO, default P4 pins)
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
# New firmware runs on trial; if it doesn't confirm itself, the old one comes back
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# The camp laptop serves over plain http on the camp Wi-Fi
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Freeze watch (freeze_watch.c) lists every task's state when the screen stops updating
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# TLS buffers in PSRAM: the screen, audio and journey tasks leave little internal RAM
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
